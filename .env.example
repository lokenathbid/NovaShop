# Environment variables template
# Copy this file to .env and adjust the values for your environment.

# Database URL (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/novashop"

# Auth.js / NextAuth
AUTH_SECRET="your-auth-secret-min-32-chars"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay Payment Gateway (Test Mode / Production)
# Obtain from Razorpay Dashboard -> Account & Settings -> API Keys
# Public key for frontend checkout initialization
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
# Server-side key ID
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
# CRITICAL: Server-only secret key. Never expose in client code or Git!
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Razorpay Webhook Secret
# Configure in Razorpay Dashboard -> Account & Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
