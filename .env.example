# Environment variables template
# Copy this file to .env and adjust the values for your environment.

# Database URL (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/novashop"

# Auth.js / NextAuth
AUTH_SECRET="your-auth-secret-min-32-chars"
